{
  "nameAPP": "user-services",
  "port": "8080",
  "configContainer": {
    "cpus": "1.0",
    "memory": "800m",
    "memorySwap": "800m"
  },
  "environment": [
    {
      "name": "SPRING_PROFILES_ACTIVE",
      "value": "prod"
    },
    {
      "name": "DATABASE_URL",
      "value": "jdbc:postgresql://usuario_db:5432/x_u01"
    },
    {
      "name": "DATABASE_USER",
      "value": "SECRET::DATABASE_USER"
    },
    {
      "name": "DATABASE_PASS",
      "value": "SECRET::DATABASE_PASS"
    },
    {
      "name": "SECURITY_ENABLE",
      "value": "true"
    },
    {
      "name": "PORT",
      "value": "8080"
    },
    {
      "name": "REDIS_HOST",
      "value": "redis-server"
    },
    {
      "name": "REDIS_PORT",
      "value": "6379"
    },
    {
      "name": "REDIS_PASSWORD",
      "value": "SECRET::REDIS_PASSWORD"
    },
    {
      "name": "SHOW_SQL",
      "value": "false"
    },
    {
      "name": "CACHE_DURATION_CONSULTA_PESSOA_EMAIL",
      "value": "PT72H"
    },
    {
      "name": "CACHE_DURATION_CONSULTA_LOGIN_EMAIL",
      "value": "PT72H"
    },
    {
      "name": "APP_SCOPES",
      "value": "users"
    },
    {
      "name": "AWS_ACCESS_KEY",
      "value": "SECRET::AWS_ACCESS_KEY"
    },
    {
      "name": "AWS_SECRET_KEY",
      "value": "SECRET::AWS_SECRET_KEY"
    },
    {
      "name": "JAVA_TOOL_OPTIONS",
      "value": "-javaagent:/app/elastic-apm-agent.jar -Xms128m -Xmx320m -Xss512k -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=80m -XX:MaxDirectMemorySize=64m -XX:+UseSerialGC -Dio.netty.maxDirectMemory=67108864 -Dio.netty.allocator.numDirectArenas=1 -Dio.netty.allocator.numHeapArenas=1 -Dio.netty.allocator.maxOrder=8"
    },
    {
      "name": "ELASTIC_APM_SERVICE_NAME",
      "value": "user-services"
    },
    {
      "name": "ELASTIC_APM_SERVER_URL",
      "value": "http://apm-server:8200"
    },
    {
      "name": "ELASTIC_APM_ENVIRONMENT",
      "value": "prod"
    },
    {
      "name": "ELASTIC_APM_APPLICATION_PACKAGES",
      "value": "br.com.user"
    },
    {
      "name": "SWAGGER_ENABLED",
      "value": "false"
    },
    {
      "name": "ELASTIC_APM_TRANSACTION_SAMPLE_RATE",
      "value": "0.2"
    },
    {
      "name": "ELASTIC_APM_SPAN_STACK_TRACE_MIN_DURATION",
      "value": "50ms"
    },
    {
      "name": "ELASTIC_APM_CAPTURE_BODY",
      "value": "off"
    },
    {
      "name": "ELASTIC_APM_CAPTURE_HEADERS",
      "value": "false"
    },
    {
      "name": "ELASTIC_APM_METRICS_INTERVAL",
      "value": "60s"
    }
  ]
}
