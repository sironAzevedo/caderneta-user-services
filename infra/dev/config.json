{
  "nameAPP": "user-services",
  "port": "8080",
  "configContainer": {
    "cpus": "1.0",
    "memory": "800m",
    "memorySwap": "1G"
  },
  "environment": [
    {
      "name": "DATABASE_URL",
      "value": "SECRET::DATABASE_URL"
    },
    {
      "name": "DATABASE_USER",
      "value": "SECRET::DATABASE_USER"
    },
    {
      "name": "DATABASE_PASS",
      "value": "SECRET::DATABASE_PASS"
    }
  ]
}
